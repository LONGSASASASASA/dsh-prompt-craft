{
  "name": "dsh-prompt-craft",
  "version": "0.2.3",
  "description": "Goal-oriented prompt enhancement for DeepSeek Harness: rewrites drafts around the outcome they serve, with diff review, per-section accept, clarifying questions and a refine loop.",
  "type": "commonjs",
  "main": "./lib/host/index.cjs",
  "exports": {
    ".": "./lib/host/index.cjs",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1+": "compatible"
      }
    },
    "manifestVersion": 1
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:min": "node scripts/build.mjs --minify",
    "check": "node scripts/build.mjs --check",
    "test": "node --test \"test/**/*.test.cjs\"",
    "prepublishOnly": "node scripts/build.mjs && node --test \"test/**/*.test.cjs\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "prompt-optimizer",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LONGSASASASASA/dsh-prompt-craft.git"
  },
  "homepage": "https://github.com/LONGSASASASASA/dsh-prompt-craft#readme",
  "bugs": {
    "url": "https://github.com/LONGSASASASASA/dsh-prompt-craft/issues"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
